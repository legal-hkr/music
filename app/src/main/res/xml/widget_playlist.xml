<?xml version="1.0" encoding="utf-8"?>
<!-- Playlist (SPEC-widgets §5): two cells wide, 2×2 by default and 2×1; the width is fixed, as three cells by
     two rows look wrong (owner's decision) – the wide form is a widget of its own (widget_playlist_wide).
     One playlist per widget, chosen when it is placed and changeable later. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="sh.hnet.music.widget.PlaylistWidgetConfigActivity"
    android:description="@string/desc_widget_playlist"
    android:initialLayout="@layout/widget_playlist_floating_square"
    android:maxResizeHeight="150dp"
    android:minWidth="150dp"
    android:minHeight="150dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="50dp"
    android:previewLayout="@layout/widget_playlist_floating_square"
    android:resizeMode="vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
