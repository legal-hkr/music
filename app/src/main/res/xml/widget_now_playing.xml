<?xml version="1.0" encoding="utf-8"?>
<!-- Now playing (SPEC-widgets §3): 4×2 by default, down to 4×1 and 2×2, never taller than two rows
     (owner's decision). Updated on events only. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/desc_widget_now_playing"
    android:initialLayout="@layout/widget_now_playing_wide"
    android:minWidth="250dp"
    android:maxResizeHeight="150dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="50dp"
    android:previewLayout="@layout/widget_now_playing_wide"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
