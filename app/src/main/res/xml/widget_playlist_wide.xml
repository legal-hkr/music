<?xml version="1.0" encoding="utf-8"?>
<!-- Playlist, wide (SPEC-widgets §5): four cells wide, 4×2 by default and 4×1; the width is fixed (see widget_playlist). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="sh.hnet.music.widget.PlaylistWidgetConfigActivity"
    android:description="@string/desc_widget_playlist"
    android:initialLayout="@layout/widget_playlist_wide"
    android:maxResizeHeight="150dp"
    android:minWidth="300dp"
    android:minHeight="150dp"
    android:minResizeWidth="300dp"
    android:minResizeHeight="50dp"
    android:previewLayout="@layout/widget_playlist_wide"
    android:resizeMode="vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
