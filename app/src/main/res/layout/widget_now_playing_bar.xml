<?xml version="1.0" encoding="utf-8"?>
<!-- Now playing, 4×1 (SPEC-widgets §3.3): a fully rounded bar with the cookie cover, title, artist and Play/Pause. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_cookie_note" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/label_widget_nothing_playing"
            android:textColor="@color/widget_on_surface" />

        <TextView
            android:id="@+id/widget_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/desc_widget_tap_to_open"
            android:textColor="@color/widget_on_surface_variant" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_play"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/widget_button_container_rounded"
        android:contentDescription="@string/content_description_play"
        android:padding="16dp"
        android:src="@drawable/ic_play_arrow"
        android:tint="@color/widget_on_primary_container" />
</LinearLayout>
