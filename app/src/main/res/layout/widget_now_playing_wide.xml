<?xml version="1.0" encoding="utf-8"?>
<!-- Now playing, 4×2, floating (SPEC-widgets rev. 2 §3.1): no widget background. The round cover as tall as the
     widget; the label with title and artist starting over the cover's end; Previous – Play/Pause – Next under it. -->
<!-- The outer frame is there for the launcher: a widget that names its background and clips to it is left
     alone, where otherwise the whole widget is cut to the system's rounded corners – and with it the corner of a
     label that reaches the widget's edge. The frame has nothing to draw, so it clips to the plain rectangle. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <RelativeLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="UselessParent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- As tall as the widget, so it grows with it -->
        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:maxWidth="240dp"
            android:scaleType="fitStart"
            android:src="@drawable/widget_circle_note" />

        <LinearLayout
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="-40dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="3dp"
            android:layout_toEndOf="@id/widget_cover"
            android:background="@drawable/widget_label"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_widget_nothing_playing"
                android:textSize="16sp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface" />

            <TextView
                android:id="@+id/widget_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface_variant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/widget_label"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="18dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_previous"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/widget_button_surface_circle"
                    android:contentDescription="@string/content_description_previous"
                    android:elevation="2dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_skip_previous"
                    android:tint="@color/widget_on_surface" />

                <ImageView
                    android:id="@+id/widget_play"
                    android:layout_width="60dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/widget_button_primary_rounded"
                    android:contentDescription="@string/content_description_play"
                    android:elevation="2dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_play_arrow"
                    android:tint="@color/widget_on_primary" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/widget_button_surface_circle"
                    android:contentDescription="@string/content_description_next"
                    android:elevation="2dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_skip_next"
                    android:tint="@color/widget_on_surface" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
