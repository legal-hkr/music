<?xml version="1.0" encoding="utf-8"?>
<!-- Now playing, 4×2 (SPEC-widgets §3.2): the cookie cover, then title, artist and Previous – Play/Pause – Next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="116dp"
        android:layout_height="116dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_cookie_note" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/label_widget_nothing_playing"
            android:textColor="@color/widget_on_surface" />

        <TextView
            android:id="@+id/widget_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/desc_widget_tap_to_open"
            android:textColor="@color/widget_on_surface_variant" />

        <LinearLayout
            android:id="@+id/widget_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_previous"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_button_tonal_circle"
                android:contentDescription="@string/content_description_previous"
                android:padding="8dp"
                android:src="@drawable/ic_skip_previous"
                android:tint="@color/widget_on_secondary_container" />

            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_button_primary_rounded_wide"
                android:contentDescription="@string/content_description_play"
                android:padding="12dp"
                android:src="@drawable/ic_play_arrow"
                android:tint="@color/widget_on_primary" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_button_tonal_circle"
                android:contentDescription="@string/content_description_next"
                android:padding="8dp"
                android:src="@drawable/ic_skip_next"
                android:tint="@color/widget_on_secondary_container" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
