<?xml version="1.0" encoding="utf-8"?>
<!-- A floating widget one row high (SPEC-widgets rev. 2 §3.3, §5.2), for Now playing and the Playlist widget: no
     widget background. The cover as tall as the widget at the start, the label over its end, and – for Now
     playing – Play/Pause at the end. Which of the label and the button there is room for, and how wide the label may get before the button, is
     set from the code. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitStart"
        android:src="@drawable/widget_circle_note" />

    <LinearLayout
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:ignore="RelativeOverlap"
        android:layout_centerVertical="true"
        android:layout_marginStart="-22dp"
        android:layout_toEndOf="@id/widget_cover"
        android:background="@drawable/widget_label"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_widget_nothing_playing"
            android:textSize="15sp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface" />

        <TextView
            android:id="@+id/widget_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_play"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="3dp"
        android:background="@drawable/widget_button_primary_rounded"
        android:contentDescription="@string/content_description_play"
        android:elevation="2dp"
        android:padding="16dp"
        android:src="@drawable/ic_play_arrow"
        android:tint="@color/widget_on_primary" />
</RelativeLayout>
