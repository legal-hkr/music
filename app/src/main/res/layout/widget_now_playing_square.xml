<?xml version="1.0" encoding="utf-8"?>
<!-- Now playing, 2×2, floating (SPEC-widgets rev. 2 §3.2): no widget background. The round cover as large as the
     room above the label allows; Play/Pause over its lower right; the title alone in a label at the bottom.
     The same arrangement as widget_playlist_floating_square; apart, as each is its widget's preview in the
     launcher's list and shows its own shape there. -->
<!-- The outer frame is there for the launcher: a widget that names its background and clips to it is left
     alone, where otherwise the whole widget is cut to the system's rounded corners – and with it the corner of a
     label that reaches the widget's edge. The frame has nothing to draw, so it clips to the plain rectangle. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <RelativeLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="UselessParent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="3dp"
            android:background="@drawable/widget_label"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_widget_nothing_playing"
                android:textSize="14sp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_above="@id/widget_label"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="4dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_circle_note" />

        <ImageView
            android:id="@+id/widget_play"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignEnd="@id/widget_cover"
            android:layout_alignBottom="@id/widget_cover"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_button_primary_rounded"
            android:contentDescription="@string/content_description_play"
            android:elevation="2dp"
            android:padding="14dp"
            android:src="@drawable/ic_play_arrow"
            android:tint="@color/widget_on_primary" />
    </RelativeLayout>
</FrameLayout>
