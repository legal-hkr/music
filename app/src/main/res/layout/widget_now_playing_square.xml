<?xml version="1.0" encoding="utf-8"?>
<!-- Now playing, 2×2 (SPEC-widgets §3.1): the cookie cover with Play/Pause over its lower right, title and artist below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="6dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_cookie_note" />

        <ImageView
            android:id="@+id/widget_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/widget_button_primary_rounded"
            android:contentDescription="@string/content_description_play"
            android:padding="12dp"
            android:src="@drawable/ic_play_arrow"
            android:tint="@color/widget_on_primary" />
    </FrameLayout>

    <!-- Cover and lines stay together in the middle, whatever the widget's height -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="14sp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/label_widget_nothing_playing"
            android:textColor="@color/widget_on_surface" />

    <TextView
        android:id="@+id/widget_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="12sp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/desc_widget_tap_to_open"
            android:textColor="@color/widget_on_surface_variant" />
    </LinearLayout>
</LinearLayout>
