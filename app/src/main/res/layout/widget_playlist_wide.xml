<?xml version="1.0" encoding="utf-8"?>
<!-- Playlist, 4×2 in system colors (SPEC-widgets §5.2): the mosaic in the cookie, the name, the length, Play and Shuffle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="116dp"
        android:layout_height="116dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_cookie_empty" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/label_widget_playlist"
            android:textColor="@color/widget_on_surface"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/widget_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_play"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/widget_button_primary_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_play_arrow"
                    android:tint="@color/widget_on_primary" />

                <TextView
                    android:id="@+id/widget_play_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/content_description_play"
                    android:textColor="@color/widget_on_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_shuffle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_button_tonal_circle"
                android:contentDescription="@string/label_widget_playlist"
                android:padding="9dp"
                android:src="@drawable/ic_shuffle"
                android:tint="@color/widget_on_secondary_container" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
