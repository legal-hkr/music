<?xml version="1.0" encoding="utf-8"?>
<!-- The outline of a widget without a background: nothing to see, but a shape with the labels' own rounding. The
     launcher takes the widget's shape from it – for clipping, and for the moment an app closes back into the widget,
     when it shows a background of its own in this shape (square-cornered without it). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="18dp" />
    <solid android:color="@android:color/transparent" />
</shape>
